# App Settings
PAYMENT_GATEWAY_APP_NAME="Payment Gateway API"
PAYMENT_GATEWAY_ENVIRONMENT=development
PAYMENT_GATEWAY_DEBUG=true
PAYMENT_GATEWAY_API_V1_PREFIX=/api/v1
PORT=8000
LOG_LEVEL=DEBUG

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payment_gateway
DB_PORT_EXTERNAL=5432
PAYMENT_GATEWAY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payment_gateway

# Docker / LocalStack Configuration
RESTART_POLICY=unless-stopped
DEBUG=0
